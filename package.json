{
  "name": "soundtrace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "声迹：把声音留在发生地点的前后端 Web 应用",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "test": "node --test",
    "start": "node server/index.js",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "cesium": "1.130.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "maplibre-gl": "^6.17.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.6.0",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "4.1.1"
  },
  "overrides": {
    "@zip.js/zip.js": "2.7.73"
  }
}
